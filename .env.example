# Two environments (copy values into the real files; those are gitignored):
#
#   .env.development  → bun run dev          (test)
#   .env.production   → bun run build:win    (employee installer)
#
# Same Atlas cluster is fine; use different MONGODB_DB names to keep data apart.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB=kooyai
