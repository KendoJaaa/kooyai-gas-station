{
  "name": "kooyai-gas-station",
  "version": "1.1.5",
  "description": "แบบบันทึกสถานีน้ำมัน ออฟไลน์ สำหรับ Windows — บันทึกในเครื่อง ส่งออก PDF",
  "main": "./out/main/index.js",
  "author": "KendoJaaa",
  "license": "MIT",
  "homepage": "https://github.com/KendoJaaa/kooyai-gas-station",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "build": "bun run typecheck && electron-vite build",
    "postinstall": "node node_modules/electron-builder/cli.js install-app-deps",
    "build:win": "bun run build && electron-builder --win nsis",
    "build:win7": "bun scripts/build-win7.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@sentry/electron": "8.0.0",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@mantine/core": "^8.3.2",
    "@mantine/dates": "^8.3.2",
    "@mantine/form": "^8.3.2",
    "@mantine/hooks": "^8.3.2",
    "@mantine/notifications": "^8.3.2",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "dayjs": "^1.11.18",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "mantine-form-zod-resolver": "^1.3.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "zod": "^4.1.12"
  }
}
